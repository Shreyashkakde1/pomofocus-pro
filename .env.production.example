# ==============================================================================
# Pomofocus Pro - Production Environment Variables
# Copy this file to .env.production on your VPS:
#   cp .env.production.example .env.production
# ==============================================================================

# Database Credentials
DB_USER=pomofocus
DB_PASSWORD=replace_with_a_strong_database_password_123

# JWT Secret Key (Must be at least 64 characters / 512 bits)
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_strong_random_jwt_secret_key_at_least_64_characters_long

# Allowed CORS Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=https://pomofocus.shreyashkakde.in,http://pomofocus.shreyashkakde.in
